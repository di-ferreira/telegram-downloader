# Telegram API Credentials
# Get your API_ID and API_HASH at https://my.telegram.org/apps
API_ID=123456
API_HASH=your_api_hash_here

# Phone number for login (with country code)
PHONE=+5511999999999

# New channel settings
CHANNEL_NAME=My Restored Channel
CHANNEL_DESCRIPTION=Channel restored from backup
CHANNEL_USERNAME=my_restored_channel

# Path to the backup folder (relative to project root)
BACKUP_FOLDER=downloads

# Session file name (optional)
SESSION_NAME=telegram_restore

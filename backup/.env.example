# Telegram API Credentials
# Get your API_ID and API_HASH at https://my.telegram.org/apps
API_ID=123456
API_HASH=your_api_hash_here

# Channel to backup (username or invite link)
CHANNEL=@channel_username

# Output directory for downloaded files (relative to project root)
OUTPUT_DIR=downloads

# Maximum concurrent downloads (default: 5)
CONCURRENT_DOWNLOADS=5

# Session file name (optional)
SESSION_NAME=telegram_backup
